theme = Atom One Dark

# font
font-family = JetBrainsMonoNL Nerd Font Mono
font-size = 16

# shell
shell-integration = fish
command = /opt/homebrew/bin/fish --login

# window
window-decoration = true
window-padding-y = 0
window-padding-x = 0

# macOS
macos-titlebar-style = tabs
macos-option-as-alt = true
